local function ensureFolder()
    if canSave and type(makefolder) == "function" then
        local exists = type(isfolder) == "function" and isfolder(KeyConfig.Folder)
        if not exists then
            pcall(makefolder, KeyConfig.Folder)
        end
    end
end

local function loadSaved()
    if not (canSave and KeyConfig.RememberKey) then
        return nil
    end

    local ok, data = pcall(function()
        if isfile(KEY_FILE) then
            return HttpService:JSONDecode(readfile(KEY_FILE))
        end
        return nil
    end)

    if not (ok and type(data) == "table" and type(data.key) == "string") then
        return nil
    end

    -- saved on another pc: make them type it again
    if KeyConfig.HwidLock and data.hwid and data.hwid ~= hwid() then
        return nil
    end

    -- the site's keys run out, so the saved one shouldn't outlive it
    if KeyConfig.KeyHours > 0 and not isLifetime(data.key) and type(data.at) == "number" then
        if os.time() - data.at > KeyConfig.KeyHours * 3600 then
            return nil
        end
    end

    return data.key
end

local function saveKey(key)
    if not (canSave and KeyConfig.RememberKey) then
        return
    end
    ensureFolder()
    pcall(function()
        writefile(KEY_FILE, HttpService:JSONEncode({
            key = key,
            hwid = hwid(),
            at = os.time(),
        }))
    end)
end

local function clearKey()
    if canSave then
        pcall(function()
            if isfile(KEY_FILE) then
                writefile(KEY_FILE, HttpService:JSONEncode({}))
            end
        end)
    end
end

