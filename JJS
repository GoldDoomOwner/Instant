        end
        return
    end

    -- sit it on the ground rather than through the middle of you
    Ring.update(root.Position - Vector3.new(0, 2.9, 0), Triangle.AfkRadius)
end))

--=========================================================
--  AFK farm: work through everyone inside the ring
--=========================================================

local function playerInRange(player, myRoot)
    if not player or player == LocalPlayer or not player.Parent then
        return false
    end
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not (hum and root and hum.Health > 0) then
        return false
    end
    return (root.Position - myRoot.Position).Magnitude <= Triangle.AfkRadius
end

local function nearestInRange(myRoot)
    local best, bestDist
    for _, player in ipairs(Players:GetPlayers()) do
        if playerInRange(player, myRoot) then
            local dist = (player.Character.HumanoidRootPart.Position - myRoot.Position).Magnitude
            if not bestDist or dist < bestDist then
                best, bestDist = player, dist
            end
        end
    end
    return best, bestDist
end

Triangle.AfkLabel = nil

task.spawn(function()
    while Triangle.Alive do
        task.wait(0.4)

        if Triangle.AfkFarm then
            local ok, err = pcall(function()
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local myRoot = char and char:FindFirstChild("HumanoidRootPart")

                if not (hum and myRoot and hum.Health > 0) then
                    if Triangle.Running then
                        stopTriangle()
                    end
                    return
                end

                -- stay on the current one while they're alive and still inside the ring
                local current = Triangle.TargetPlayer
                if playerInRange(current, myRoot) then
                    if not Triangle.Running then
                        Triangle.AllowPlayers = true
                        setTarget(current.Character, current)
                        startTriangle()
                    end
                    return
                end

                local next_ = nearestInRange(myRoot)
                if next_ then
                    Triangle.AllowPlayers = true
                    if Triangle.Running then
                        stopTriangle()
                    end
                    setTarget(next_.Character, next_)
                    startTriangle()
                elseif Triangle.Running then
                    stopTriangle()
                end
            end)

            if not ok then
                warn("[Instant] afk farm error: " .. tostring(err))
            end
        end
    end
end)

-- live count of who is inside the ring
