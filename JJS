--=========================================================
--  Player leaderboard in the Kogane menu
--  The game deletes its Shenanigans ui when it's not in use,
--  so we clone our own copy from ReplicatedStorage.Utils.Kogane
--  each time Players is pressed, and fill it with one card
--  per player: name, kills (leaderstats.Kills) and bio.
--=========================================================

local Leaderboard = { open = false, gui = nil, cards = {}, bios = {}, fetching = {} }

local function setText(obj, text)
    if not obj then
        return
    end
    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
        obj.Text = text
        return
    end
    local label = obj:FindFirstChildWhichIsA("TextLabel", true) or obj:FindFirstChildWhichIsA("TextButton", true)
    if label then
        label.Text = text
    end
end

local function killsOf(player)
    local stats = player:FindFirstChild("leaderstats")
    local kills = stats and stats:FindFirstChild("Kills")
    return kills and tonumber(kills.Value) or 0
end

local function sourceGui()
    local utils = game:GetService("ReplicatedStorage"):FindFirstChild("Utils")
    local kogane = utils and utils:FindFirstChild("Kogane")
    return kogane and kogane:FindFirstChild("Shenanigans")
end

local function fmtAttr(value)
    if value == nil then
        return "?"
    end
    if type(value) == "number" then
        local text = tostring(math.floor(value))
        local done
        repeat
            text, done = text:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
        until done == 0
        return text
    end
    return tostring(value)
end

local function statsText(player)
    return "Cash: " .. fmtAttr(player:GetAttribute("Cash"))
        .. "  |  Donated: " .. fmtAttr(player:GetAttribute("Donated"))
        .. "\nMoveset: " .. fmtAttr(player:GetAttribute("Moveset"))
        .. "  |  Ultimate: " .. fmtAttr(player:GetAttribute("Ultimate"))
end

-- a second Description holding the player's attributes; placed by layoutCard
local function statsLabel(card)
    local existing = card:FindFirstChild("Stats")
    if existing then
        return existing
    end
    local desc = card:FindFirstChild("Description")
    if not desc then
        return nil
    end
    local copy = desc:Clone()
    copy.Name = "Stats"
    copy.Visible = false            -- shown once it has been placed, so it never flashes over the title
    copy.Parent = desc.Parent
    return copy
end

-- short text like "No bio" blows up under TextScaled, so cap it
local function capTextSize(label, max)
    if label and (label:IsA("TextLabel") or label:IsA("TextButton")) and label.TextScaled then
        local cap = label:FindFirstChildOfClass("UITextSizeConstraint") or Instance.new("UITextSizeConstraint")
        cap.MaxTextSize = max
        cap.Parent = label
    end
end

-- Measure where everything actually sits, pin it there in pixels, then put Stats under
-- the lowest piece and the Separator under Stats, and grow the card to fit. Works
-- whatever order the prefab uses, because it reads the real on-screen positions.
local function layoutCard(card)
    if card:GetAttribute("LBLaidOut") or not card:IsA("GuiObject") then
        return true
    end
    local stats = card:FindFirstChild("Stats")
    local desc = card:FindFirstChild("Description")
    if not (stats and desc) or card.AbsoluteSize.Y < 1 or desc.AbsoluteSize.Y < 1 then
        return false                -- not drawn yet, try again shortly
    end

    local pad = card:FindFirstChildOfClass("UIPadding")
    local cardSize = card.AbsoluteSize
    local padTop = pad and (pad.PaddingTop.Scale * cardSize.Y + pad.PaddingTop.Offset) or 0
    local padLeft = pad and (pad.PaddingLeft.Scale * cardSize.X + pad.PaddingLeft.Offset) or 0
    local padBottom = pad and (pad.PaddingBottom.Scale * cardSize.Y + pad.PaddingBottom.Offset) or 0
    local origin = card.AbsolutePosition + Vector2.new(padLeft, padTop)

    -- measure
    local placed = {}
    for _, child in ipairs(card:GetChildren()) do
        if child:IsA("GuiObject") and child ~= stats then
            placed[child] = { pos = child.AbsolutePosition - origin, size = child.AbsoluteSize }
        end
    end

    -- pin everything where it already is, in pixels
    for child, m in pairs(placed) do
        child.AnchorPoint = Vector2.zero
        child.Position = UDim2.fromOffset(m.pos.X, m.pos.Y)
        child.Size = UDim2.fromOffset(m.size.X, m.size.Y)
    end

    local separator = card:FindFirstChild("Separator")
    local lowest = 0
    for child, m in pairs(placed) do
        if child ~= separator then
            lowest = math.max(lowest, m.pos.Y + m.size.Y)
        end
    end

    -- Stats: same width as the bio, two lines tall
    local activate = card:FindFirstChild("Activate")
    local lineH = (activate and activate.AbsoluteSize.Y > 0) and activate.AbsoluteSize.Y or 18
    local statsH = math.floor(lineH * 2 + 4)
    local d = placed[desc]
    stats.AnchorPoint = Vector2.zero
    stats.Position = UDim2.fromOffset(d.pos.X, lowest + 4)
    stats.Size = UDim2.fromOffset(d.size.X, statsH)
    stats.TextScaled = false
    stats.TextWrapped = true
    stats.TextSize = math.max(12, math.floor(lineH * 0.8))
    stats.TextYAlignment = Enum.TextYAlignment.Top
    stats.Visible = true

    local bottom = lowest + 4 + statsH
    local gapBelow = 4
    if separator and placed[separator] then
        local m = placed[separator]
        -- keep the gap the prefab had under its separator
        gapBelow = math.clamp(cardSize.Y - padTop - padBottom - (m.pos.Y + m.size.Y), 0, 20)
        separator.Position = UDim2.fromOffset(m.pos.X, bottom + 4)
        bottom = bottom + 4 + m.size.Y
    end

    if card.AutomaticSize ~= Enum.AutomaticSize.Y and card.AutomaticSize ~= Enum.AutomaticSize.XY then
        card.Size = UDim2.new(card.Size.X.Scale, card.Size.X.Offset, 0, math.ceil(bottom + gapBelow + padTop + padBottom))
    end

    card:SetAttribute("LBLaidOut", true)
    return true
end

local function template()
    local src = sourceGui()
    local prefabs = src and src:FindFirstChild("Prefabs")
    return prefabs and prefabs:FindFirstChild("Shenanigan")
end

local function fetchBio(player)
    local id = player.UserId
    if Leaderboard.bios[id] or Leaderboard.fetching[id] then
        return
    end
    Leaderboard.fetching[id] = true

    task.spawn(function()
        local body
        for _, host in ipairs({ "users.roblox.com", "users.roproxy.com" }) do
            local url = "https://" .. host .. "/v1/users/" .. id
            if httpRequest then
                local ok, res = pcall(httpRequest, { Url = url, Method = "GET" })
                if ok and type(res) == "table" and res.StatusCode == 200 then
                    body = res.Body
                end
            end
            if not body then
                local ok, text = pcall(function()
                    return game:HttpGet(url)
                end)
                if ok and type(text) == "string" and text:sub(1, 1) == "{" then
                    body = text
                end
            end
            if body then
                break
            end
        end

        local bio = "Couldn't load bio"
        if body then
            bio = "No bio"
            local ok, data = pcall(function()
                return game:GetService("HttpService"):JSONDecode(body)
            end)
            if ok and type(data) == "table" and type(data.description) == "string" then
                local trimmed = data.description:gsub("^%s+", ""):gsub("%s+$", "")
                if trimmed ~= "" then
                    bio = #trimmed > 200 and (trimmed:sub(1, 197) .. "...") or trimmed
                end
            end
        end

        Leaderboard.bios[id] = bio
        Leaderboard.fetching[id] = nil
        if Leaderboard.open then
            pcall(Leaderboard.refresh)
        end
    end)
end

local function listOf(gui)
    local screen = gui and gui:FindFirstChild("Screen")
    return screen, screen and screen:FindFirstChild("List")
end

function Leaderboard.refresh()
    local gui = Leaderboard.gui
    local _, list = listOf(gui)
    local proto = template()
    if not (gui and gui.Parent and list and proto) then
        return
    end

    local players = Players:GetPlayers()
    table.sort(players, function(a, b)
        local ka, kb = killsOf(a), killsOf(b)
        if ka ~= kb then
            return ka > kb
        end
        return a.Name:lower() < b.Name:lower()
    end)

    local seen = {}
    for rank, player in ipairs(players) do
        seen[player] = true
        local card = Leaderboard.cards[player]
        if not card or not card.Parent then
            card = proto:Clone()
            card.Name = "LB_" .. player.UserId
            card.Parent = list
            Leaderboard.cards[player] = card
        end

        card.Visible = true
        card.LayoutOrder = rank

        local title = card:FindFirstChild("Title")
        setText(title and title:FindFirstChild("Title") or title, player.Name)
        setText(card:FindFirstChild("Activate"), killsOf(player) .. " Kills")

        local bio = Leaderboard.bios[player.UserId]
        if not bio then
            fetchBio(player)
        end
        local desc = card:FindFirstChild("Description")
        capTextSize(desc, 18)
        setText(desc, bio or "Loading bio...")
        setText(statsLabel(card), statsText(player))

        if not card:GetAttribute("LBLaidOut") then
            -- wait for the card to be drawn so its real positions can be measured
            task.spawn(function()
                for _ = 1, 30 do
                    RunService.RenderStepped:Wait()
                    if not card.Parent or layoutCard(card) then
                        return
                    end
                end
            end)
        end
    end

    for player, card in pairs(Leaderboard.cards) do
        if not seen[player] then
            card:Destroy()
            Leaderboard.cards[player] = nil
        end
    end
end

function Leaderboard.hide()
    Leaderboard.open = false
    Leaderboard.cards = {}
    if Leaderboard.gui then
        Leaderboard.gui:Destroy()
        Leaderboard.gui = nil
    end
end

function Leaderboard.show()
    local src = sourceGui()
    if not src then
        notify("ReplicatedStorage.Utils.Kogane.Shenanigans not found")
        return
    end
    if not template() then
        notify("Shenanigans.Prefabs.Shenanigan not found")
        return
    end

    Leaderboard.hide()

    local gui = src:Clone()
    gui.Name = "InstantLeaderboard"      -- its own name, so the game's cleanup leaves it alone

    -- the game's scripts would run on our copy and might tear it down; strip them
    for _, item in ipairs(gui:GetDescendants()) do
        if item:IsA("BaseScript") then
            item:Destroy()
        end
    end

    local screen, list = listOf(gui)
    if not (screen and list) then
        gui:Destroy()
        notify("Shenanigans has no Screen.List")
        return
    end

    -- everything already in the list goes, only player cards are shown
    for _, item in ipairs(list:GetChildren()) do
        if item:IsA("Frame") then
            item.Visible = false
        end
    end
    -- the template folder isn't needed in the copy
    local prefabs = gui:FindFirstChild("Prefabs")
    if prefabs and prefabs:IsA("GuiObject") then
        prefabs.Visible = false
    end

    if gui:IsA("ScreenGui") then
        gui.ResetOnSpawn = false
        gui.Enabled = true
    end
    screen.Visible = true
    gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

    -- any close button in the copy closes the leaderboard
    for _, item in ipairs(gui:GetDescendants()) do
        if item:IsA("GuiButton") then
            local n = item.Name:lower()
            if n == "close" or n == "exit" or n == "x" or n == "back" then
                item.Activated:Connect(Leaderboard.hide)
            end
        end
    end

    Leaderboard.gui = gui
    Leaderboard.open = true
    Leaderboard.refresh()
end

-- hook the More button; the menu gets rebuilt, so re-hook whenever a new one appears
local hookedButtons = setmetatable({}, { __mode = "k" })

local function hookMenu(menu)
    local button = menu:FindFirstChild("More") or menu:FindFirstChild("More", true)
    if not button or hookedButtons[button] then
        return
    end
    hookedButtons[button] = true

    if getconnections then
        for _, signal in ipairs({ "Activated", "MouseButton1Click", "MouseButton1Down" }) do
            pcall(function()
                for _, conn in ipairs(getconnections(button[signal])) do
                    if conn.Disable then
                        conn:Disable()
                    else
                        conn:Disconnect()
                    end
                end
            end)
        end
    end

    button.Visible = true
    setText(button, "Players")

    pcall(function()
        button:GetPropertyChangedSignal("Text"):Connect(function()
            if button.Text ~= "Players" then
                button.Text = "Players"
            end
        end)
    end)
    button:GetPropertyChangedSignal("Visible"):Connect(function()
        if not button.Visible then
            button.Visible = true
        end
    end)

    if button:IsA("GuiButton") then
        button.Activated:Connect(function()
            if not Triangle.Alive then
                return
            end
            if Leaderboard.open then
                Leaderboard.hide()
            else
                Leaderboard.show()
            end
        end)
    end
end

task.spawn(function()
    local gui = LocalPlayer:WaitForChild("PlayerGui")

    for _, item in ipairs(gui:GetDescendants()) do
        if item.Name == "KoganeMenu" then
            pcall(hookMenu, item)
        end
    end

    table.insert(Triangle.Conns, gui.DescendantAdded:Connect(function(item)
        if item.Name == "KoganeMenu" then
            task.defer(function()
                pcall(hookMenu, item)
            end)
        elseif item.Name == "More" and item:FindFirstAncestor("KoganeMenu") then
            task.defer(function()
                pcall(hookMenu, item:FindFirstAncestor("KoganeMenu"))
            end)
        end
    end))
end)

table.insert(Triangle.Conns, Players.PlayerAdded:Connect(function()
    if Leaderboard.open then
        task.wait(1)
        pcall(Leaderboard.refresh)
    end
end))
table.insert(Triangle.Conns, Players.PlayerRemoving:Connect(function()
    if Leaderboard.open then
        task.defer(function()
            pcall(Leaderboard.refresh)
        end)
    end
end))
task.spawn(function()
    while Triangle.Alive do
