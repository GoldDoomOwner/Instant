--=========================================================
--  Keyforge keys
--  same checksum the site uses, so a key it issues validates
--  here offline. cross-checked against the browser version.
--=========================================================

local ALPHA = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"

local bxor = (bit32 and bit32.bxor) or function(a, b)
    local result, bit = 0, 1
    while a > 0 or b > 0 do
        if (a % 2) ~= (b % 2) then
            result = result + bit
        end
        a = math.floor(a / 2)
        b = math.floor(b / 2)
        bit = bit * 2
    end
    return result
end

-- (a * b) mod 2^32, split so it never loses precision
local function mul32(a, b)
    local high = math.floor(a / 65536)
    local low = a % 65536
    return (((high * b) % 65536) * 65536 + low * b) % 4294967296
end

local function fnv(text)
    local h = 2166136261
    for i = 1, #text do
        h = mul32(bxor(h, text:byte(i)), 16777619)
    end
    return h
end

local function encode(h, len)
    local out = ""
    for _ = 1, len do
        local index = h % 32
        out = out .. ALPHA:sub(index + 1, index + 1)
        h = math.floor(h / 32)
    end
    return out
end

local function keyforgeValid(key)
    if KeyConfig.KeyforgeSecret == "" then
        return false
    end

    local block = "([A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9])"
    local a, b, c, sum = tostring(key):upper():match("^KF%-" .. block .. "%-" .. block .. "%-" .. block .. "%-" .. block .. "$")
    if not a then
        return false
    end

    return encode(fnv(a .. b .. c .. KeyConfig.KeyforgeSecret), 4) == sum
end

