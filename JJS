-- the hosted list wins when it loads, so a revoked key stops working everywhere
local function fetchKeys()
    if KeyConfig.KeyListURL == "" then
        return nil
    end

    local body
    if httpRequest then
        local ok, res = pcall(httpRequest, { Url = KeyConfig.KeyListURL, Method = "GET" })
        if ok and type(res) == "table" and res.StatusCode == 200 then
            body = res.Body
        end
    end
    if not body then
        local ok, text = pcall(function()
            return game:HttpGet(KeyConfig.KeyListURL)
        end)
        body = ok and text or nil
    end
    if type(body) ~= "string" or body == "" then
        return nil
    end

    -- json first, plain lines otherwise
    local ok, data = pcall(function()
        return HttpService:JSONDecode(body)
    end)
    if ok and type(data) == "table" then
        local list = data.keys or data
        if type(list) == "table" then
            local out = {}
            for _, key in pairs(list) do
                if type(key) == "string" and trim(key) ~= "" then
                    table.insert(out, trim(key))
                end
            end
            return out
        end
    end

    local out = {}
    for line in body:gmatch("[^\r\n]+") do
        local key = trim(line)
        if key ~= "" and key:sub(1, 1) ~= "#" then
            table.insert(out, key)
        end
    end
    return out
end

local function checkKey(entered)
    entered = trim(entered)
    if entered == "" then
        return false, "Type a key first"
    end

    if isLifetime(entered) then
        return true, "lifetime key"
    end

    if keyforgeValid(entered) then
        return true, "Keyforge key"
    end

    local list = fetchKeys()
    local source = "hosted list"
    if not list then
        list = KeyConfig.Keys
        source = KeyConfig.KeyListURL ~= "" and "offline list (couldn't reach the url)" or "key list"
    end

    for _, key in ipairs(list) do
        if entered:lower() == trim(key):lower() then
            return true, source
        end
    end

    if KeyConfig.KeyforgeSecret ~= "" then
        return false, "That key isn't valid. Get one from the link on Get Key"
    end
    return false, "That key isn't valid"
end

local function logUnlock(key)
    if KeyConfig.Webhook == "" or not httpRequest then
        return
    end

    local id = hwid()
    task.spawn(function()
        pcall(httpRequest, {
            Url = KeyConfig.Webhook,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode({
                username = KeyConfig.Title,
