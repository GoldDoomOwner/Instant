--=========================================================
--  Lock on: point the camera at someone and keep it there
--=========================================================

local Lock = { player = nil, highlight = nil, label = nil }

function Lock.clearHighlight()
    if Lock.highlight then
        Lock.highlight:Destroy()
        Lock.highlight = nil
    end
end

function Lock.setHighlight(character)
    Lock.clearHighlight()
    if not (character and Triangle.LockHighlight) then
        return
    end

    local hl = Instance.new("Highlight")
    hl.FillColor = Color3.fromRGB(237, 66, 69)
    hl.OutlineColor = Color3.fromRGB(255, 120, 120)
    hl.FillTransparency = 0.6
    hl.OutlineTransparency = 0
    hl.Adornee = character
    hl.Parent = character
    Lock.highlight = hl
end

function Lock.setPlayer(player)
    Lock.player = player
    Lock.setHighlight(player and player.Character or nil)
    if Lock.label then
        Lock.label:SetText("Locked: " .. (player and player.Name or "nobody"))
    end
end

-- the part we aim at, nil when they're dead or not spawned
function Lock.aimPart(player)
    if not (player and player.Parent) then
        return nil
    end
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (hum and hum.Health > 0) then
        return nil
    end
    return char:FindFirstChild(Triangle.LockPart) or char:FindFirstChild("HumanoidRootPart")
end

function Lock.pick()
    if Triangle.LockMode == "Farm target" then
        local player = Triangle.TargetPlayer
        return Lock.aimPart(player) and player or nil
    end

    local camera = workspace.CurrentCamera
    if not camera then
        return nil
    end

    local mouse = UserInputService:GetMouseLocation()
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")

    local best, bestScore
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local part = Lock.aimPart(player)
            if part then
                local away = myRoot and (part.Position - myRoot.Position).Magnitude or 0
                if away <= Triangle.LockMaxDist then
                    if Triangle.LockMode == "Closest to me" then
                        if not bestScore or away < bestScore then
                            best, bestScore = player, away
                        end
                    else
                        local screen, onScreen = camera:WorldToViewportPoint(part.Position)
                        if onScreen then
                            local offset = (Vector2.new(screen.X, screen.Y) - mouse).Magnitude
                            if offset <= Triangle.LockFov and (not bestScore or offset < bestScore) then
                                best, bestScore = player, offset
                            end
                        end
                    end
                end
            end
        end
    end

    return best
end

table.insert(Triangle.Conns, RunService.RenderStepped:Connect(function()
    if not (Triangle.Alive and Triangle.LockOn) then
        return
    end

    -- whoever we had has died, left, or wandered out: find someone else
    if not Lock.aimPart(Lock.player) then
        local found = Lock.pick()
        if found ~= Lock.player then
            Lock.setPlayer(found)
        end
        if not found then
            return
        end
    elseif not Lock.highlight and Triangle.LockHighlight then
        Lock.setHighlight(Lock.player.Character)
    end

    local part = Lock.aimPart(Lock.player)
    local camera = workspace.CurrentCamera
    if not (part and camera) then
        return
    end

    local goal = CFrame.new(camera.CFrame.Position, part.Position)
    if Triangle.LockSmooth >= 1 then
        camera.CFrame = goal
    else
        camera.CFrame = camera.CFrame:Lerp(goal, Triangle.LockSmooth)
    end
end))

--=========================================================
--  Projection Sorcery
--
--  The technique splits one second into 24 frames and runs a
--  path that was plotted before it started, which is why the
--  route is locked in at the moment you trigger it here too.
--  Each frame leaves an afterimage behind.
--=========================================================

local Projection = { busy = false, images = {} }

local function stripForImage(model)
    for _, item in ipairs(model:GetDescendants()) do
        if item:IsA("BasePart") then
            item.Anchored = true
            item.CanCollide = false
            item.CanQuery = false
            item.CanTouch = false
            item.CastShadow = false
            item.Massless = true
        elseif item:IsA("BaseScript") or item:IsA("Sound") or item:IsA("ParticleEmitter")
            or item:IsA("Trail") or item:IsA("Beam") or item:IsA("Fire") or item:IsA("Smoke")
            or item:IsA("Sparkles") or item:IsA("BillboardGui") or item:IsA("SurfaceGui")
            or item:IsA("Highlight") or item:IsA("ForceField") or item:IsA("Humanoid")
            or item:IsA("Animator") or item:IsA("Tool") then
            item:Destroy()
        end
    end
end

-- a frozen copy of how you look right now, which fades out where you stood
spawnAfterimage = function()
    local char = LocalPlayer.Character
    if not char or not Triangle.Afterimages then
        return
    end

    -- too many on screen at once reads as soup, and costs frames
    while #Projection.images >= Triangle.MaxImages do
        local oldest = table.remove(Projection.images, 1)
        if oldest and oldest.Parent then
            oldest:Destroy()
        end
    end

    local ok, clone = pcall(function()
        local was = char.Archivable
        char.Archivable = true
        local copy = char:Clone()
        char.Archivable = was
        return copy
    end)
    if not ok or not clone then
        return
    end

    stripForImage(clone)

    local parts = {}
    for _, item in ipairs(clone:GetDescendants()) do
        if item:IsA("BasePart") then
            item.Material = Enum.Material.Neon
            item.Color = Triangle.ImageColor
            item.Transparency = Triangle.ImageTransparency
            table.insert(parts, item)
        elseif item:IsA("Decal") or item:IsA("Texture") then
            item.Transparency = Triangle.ImageTransparency
        end
    end

    clone.Name = "ProjectionAfterimage"
    clone.Parent = workspace
    table.insert(Projection.images, clone)

    task.spawn(function()
        local base = Triangle.ImageTransparency
        local life = Triangle.ImageLife
        local started = os.clock()

        while clone.Parent and os.clock() - started < life do
            local alpha = (os.clock() - started) / life
            local transparency = base + (1 - base) * alpha
            for _, part in ipairs(parts) do
                part.Transparency = transparency
            end
            task.wait()
        end

        for index, image in ipairs(Projection.images) do
            if image == clone then
                table.remove(Projection.images, index)
                break
            end
        end
        clone:Destroy()
    end)
end

function Projection.clearImages()
    for _, image in ipairs(Projection.images) do
        if image.Parent then
            image:Destroy()
        end
    end
    table.clear(Projection.images)
end

-- where the run ends, worked out once, before the first frame
local function plotDestination(root)
    local camera = workspace.CurrentCamera

    local part = Lock.player and Lock.aimPart(Lock.player) or nil
    if not part then
        local ok, troot = targetInfo(Triangle.Target)
        if ok then
            part = troot
        end
    end

    if part and Triangle.ProjMode ~= "Forward" then
        local toward = part.Position - root.Position
        local flat = Vector3.new(toward.X, 0, toward.Z)
        if flat.Magnitude < 0.1 then
            flat = Vector3.new(0, 0, -1)
        end
        -- pull up short so you land next to them rather than inside them
        local stop = math.min(Triangle.ProjStop, toward.Magnitude)
        return part.Position - flat.Unit * stop, part.Position
    end

    local direction = camera and camera.CFrame.LookVector or Vector3.new(0, 0, -1)
    direction = Vector3.new(direction.X, 0, direction.Z)
    if direction.Magnitude < 0.1 then
        direction = Vector3.new(0, 0, -1)
    end
    local destination = root.Position + direction.Unit * Triangle.ProjDistance
    return destination, destination + direction.Unit * 10
end

function Projection.run()
    if Projection.busy then
        return
    end

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not (hum and root and hum.Health > 0) then
        notify("You're not spawned in")
        return
    end

    -- plotted up front: the real technique can't change course once it starts
    local from = root.Position
    local destination, facing = plotDestination(root)
    local frames = math.max(1, math.floor(Triangle.ProjFrames))
    local gap = Triangle.ProjDuration / frames

    Projection.busy = true

    task.spawn(function()
        for frame = 1, frames do
            if not Triangle.Alive then
                break
            end

            local liveChar = LocalPlayer.Character
            local liveRoot = liveChar and liveChar:FindFirstChild("HumanoidRootPart")
            local liveHum = liveChar and liveChar:FindFirstChildOfClass("Humanoid")
            if not (liveRoot and liveHum and liveHum.Health > 0) then
                break
            end

            if Triangle.Afterimages and frame % Triangle.ImageEvery == 0 then
                spawnAfterimage()
            end

            local alpha = frame / frames
            local here = from:Lerp(destination, alpha)
            local look = Vector3.new(facing.X, here.Y, facing.Z)
            if (look - here).Magnitude < 0.1 then
                look = here + Vector3.new(0, 0, -1)
            end

            liveRoot.CFrame = CFrame.lookAt(here, look)
            liveRoot.AssemblyLinearVelocity = Vector3.zero

            task.wait(gap)
        end

        Projection.busy = false
    end)
end

