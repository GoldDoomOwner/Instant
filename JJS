verifyKey = function()
    -- already unlocked this session (a hop or a re-execute)
    local env = getgenv and getgenv() or _G
    if env.JJSKeyOk then
        return true
    end

    local saved = loadSaved()
    if saved then
        local ok = checkKey(saved)
        if ok then
            env.JJSKeyOk = true
            print("[JJS] key accepted from the saved file")
            return true
        end
        print("[JJS] the saved key is no longer valid")
        clearKey()
    end

    local unlocked = showKeyUI()
    if unlocked then
        env.JJSKeyOk = true
    else
        warn("[JJS] no valid key, script not loaded")
    end
    return unlocked
end

end

if not verifyKey() then
    return
end

