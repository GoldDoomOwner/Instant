            local player = Players:GetPlayerFromCharacter(model)
            if player == LocalPlayer then
                return nil, "self"
            end
            if player and not Triangle.AllowPlayers then
                return nil, "player"
            end
            return model, nil, player
        end
        model = model:FindFirstAncestorOfClass("Model")
    end
    return nil
end

local function targetInfo(model)
    if not (model and model.Parent) then
        return false
    end
    local hum = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    if hum and root and hum.Health > 0 then
        return true, root
    end
    return false
end

local function setTarget(model, player)
    if Triangle.Highlight then
        Triangle.Highlight:Destroy()
        Triangle.Highlight = nil
    end
    if Triangle.DiedConn then
        Triangle.DiedConn:Disconnect()
        Triangle.DiedConn = nil
    end

    Triangle.Target = model
    Triangle.TargetPlayer = player

    if model then
        local h = Instance.new("Highlight")
        h.FillTransparency = 0.7
        h.OutlineColor = Color3.fromRGB(255, 170, 0)
        h.Adornee = model
        h.Parent = model
        Triangle.Highlight = h

        cashAtStart = getCash()
        local hum = model:FindFirstChildOfClass("Humanoid")
        local shown = player and player.Name or model.Name
        if hum then
            Triangle.DiedConn = hum.Died:Connect(function()
                reportKill(shown)
            end)
        end
    end

    if Triangle.Label then
        Triangle.Label:SetText("Target: " .. (player and player.Name or model and model.Name or "none"))
    end
end

-- people respawn into a brand new character, so follow the player, not the old model
local function resolveTarget()
    local player = Triangle.TargetPlayer
    if not player then
        return
    end
    if not player.Parent then
        setTarget(nil)
        return
    end
    local char = player.Character
    if char and char ~= Triangle.Target then
        setTarget(char, player)
    end
end

--=========================================================
--  Attacks
--=========================================================

-- clicks on the target's screen position so aim-at-mouse games hit it
local function clickM1(troot)
    local cam = workspace.CurrentCamera
    local x, y
    local screen, onScreen = cam:WorldToViewportPoint(troot.Position)
    if onScreen then
        x, y = screen.X, screen.Y
    else
        x, y = cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2
    end
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
    task.wait(0.03)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
end

local function pressKey(keyCode)
    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
    task.wait(0.05)
    VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
end

-- the target's character gets Info.Counter while they're countering
local function isCountering(troot)
    local char = troot and troot.Parent
    local info = char and char:FindFirstChild("Info")
    local counter = info and info:FindFirstChild("Counter")
    if not counter then
        return false
    end
    -- a BoolValue set to false means it's there but not active
    if counter:IsA("BoolValue") then
        return counter.Value
    end
    return true
end

local function attack(troot)
    if Triangle.RespectCounter and isCountering(troot) then
        return
    end
    if Triangle.ClickM1 then
        clickM1(troot)
    end
    for _, name in ipairs(KEY_ORDER) do
        if Triangle.Keys[name] then
            -- they can start a counter between key presses, so check before each one
            if Triangle.RespectCounter and isCountering(troot) then
                return
            end
            pressKey(KEYCODES[name])
            task.wait(0.03)
        end
    end
end

--=========================================================
--  Loop
--=========================================================

local stopTriangle
local spawnAfterimage   -- filled in by the Projection Sorcery section further down

local function startTriangle()
    resolveTarget()
    if not targetInfo(Triangle.Target) then
        notify("Pick a target first")
        return false
    end

    Triangle.Run = Triangle.Run + 1
    local myRun = Triangle.Run
    Triangle.Running = true
    cashAtStart = getCash()

    local function active()
        return Triangle.Alive and Triangle.Running and Triangle.Run == myRun
    end

    task.spawn(function()
        -- hold off after the keybind, so you can let go of the key / line up first.
        -- toggling back off during the wait cancels it
        if Triangle.StartDelay > 0 then
            notify(("Starting in %.2fs"):format(Triangle.StartDelay))
            local until_ = os.clock() + Triangle.StartDelay
            while os.clock() < until_ do
                if not active() then
                    return
                end
                task.wait()
            end
            if not active() then
                return
            end
            cashAtStart = getCash()
        end

        local index = 0
        while active() do
            resolveTarget()

            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not (hum and root and hum.Health > 0) then
                stopTriangle("You died")
                return
            end
            if not targetInfo(Triangle.Target) then
                stopTriangle("Target is gone")
                return
            end

            -- 1 > 2 > 3 > 1, 120 degrees apart
            index = index % 3 + 1
            local angle = math.rad((index - 1) * 120)
            local deadline = os.clock() + Triangle.Dwell
            local attacked = false

            repeat
                local ok, troot = targetInfo(Triangle.Target)
                if not ok or not root.Parent then
                    break
                end
                local pos = troot.Position + Vector3.new(
                    math.cos(angle) * Triangle.Radius,
                    Triangle.Height,
                    math.sin(angle) * Triangle.Radius
                )
                local look = Vector3.new(troot.Position.X, pos.Y, troot.Position.Z)
                root.CFrame = CFrame.lookAt(pos, look)
                root.AssemblyLinearVelocity = Vector3.zero

                if not attacked then
                    attacked = true
                    if Triangle.FarmAfterimages and spawnAfterimage then
                        spawnAfterimage()
                    end
                    task.spawn(attack, troot)
                end
                RunService.Heartbeat:Wait()
            until os.clock() >= deadline or not active()
        end
    end)
    return true
end

stopTriangle = function(reason)
    if not Triangle.Running then
        return
    end
    Triangle.Running = false
    Triangle.Run = Triangle.Run + 1
    if reason then
        notify("Triangle Farm stopped: " .. reason)
    end
    if Toggles.TriangleFarm and Toggles.TriangleFarm.Value then
        Toggles.TriangleFarm:SetValue(false)
    end
end

--=========================================================
--  Radius ring
--  a real circle, built from short segments laid end to end
--=========================================================

local Ring = { model = nil, parts = {}, segments = 48, lastRadius = nil }

function Ring.destroy()
    if Ring.model then
        Ring.model:Destroy()
    end
    Ring.model = nil
    Ring.parts = {}
    Ring.lastRadius = nil
end

function Ring.build()
    Ring.destroy()

    local model = Instance.new("Model")
    model.Name = "InstantRadiusRing"

    for i = 1, Ring.segments do
        local part = Instance.new("Part")
        part.Anchored = true
        part.CanCollide = false
        part.CanQuery = false
        part.CanTouch = false
        part.CastShadow = false
        part.Material = Enum.Material.Neon
        part.Color = Color3.fromRGB(88, 101, 242)
        part.Transparency = 0.35
        part.Size = Vector3.new(0.3, 0.3, 1)
        part.Parent = model
        Ring.parts[i] = part
    end

    model.Parent = workspace
    Ring.model = model
end

function Ring.update(center, radius)
    if not Ring.model or not Ring.model.Parent then
        Ring.build()
    end

    local step = math.pi * 2 / Ring.segments
    -- straight chord between neighbouring points, plus a touch of overlap so there are no gaps
    local chord = 2 * radius * math.sin(step / 2) + 0.15
    local resize = Ring.lastRadius ~= radius
    Ring.lastRadius = radius

    for i, part in ipairs(Ring.parts) do
        local angle = step * (i - 1)
        local pos = center + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
        local tangent = Vector3.new(-math.sin(angle), 0, math.cos(angle))
        if resize then
            part.Size = Vector3.new(0.3, 0.3, chord)
        end
        part.CFrame = CFrame.lookAt(pos, pos + tangent)
    end
end

table.insert(Triangle.Conns, RunService.Heartbeat:Connect(function()
    if not (Triangle.Alive and Triangle.ShowRing) then
        if Ring.model then
            Ring.destroy()
        end
        return
