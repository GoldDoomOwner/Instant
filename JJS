local function getCash()
    local value = LocalPlayer:GetAttribute("Cash")
    if value == nil then
        local stats = LocalPlayer:FindFirstChild("leaderstats")
        local cash = stats and stats:FindFirstChild("Cash")
        value = cash and cash.Value
    end
    return tonumber(value) or 0
end

local function comma(n)
    local text = tostring(math.floor(n))
    local done
    repeat
        text, done = text:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
    until done == 0
    return text
end

local function queueEmbed(embed)
    if not httpRequest or not Triangle.SendKills or Triangle.WebhookURL == "" then
        return
    end
    embed.timestamp = DateTime.now():ToIsoDate()
    table.insert(webhookQueue, { username = "Instant", embeds = { embed } })
end

local function reportKill(name)
    local now = getCash()
    local gained = now - cashAtStart
    if gained < 0 then
        gained = 0
    end
    cashAtStart = now

    session.kills = session.kills + 1
    session.cash = session.cash + gained

    Triangle.Killed = (Triangle.Killed or 0) + 1
    if Triangle.KillLabel then
        Triangle.KillLabel:SetText("Kills: " .. session.kills .. "  |  Cash: +" .. comma(session.cash))
    end

    queueEmbed({
        title = "Kill",
        color = 0x57F287,
        fields = {
            { name = "Target", value = tostring(name), inline = true },
            { name = "Cash Gained", value = "+" .. comma(gained), inline = true },
            { name = "Cash Now", value = comma(now), inline = true },
            { name = "Session", value = session.kills .. " kills, +" .. comma(session.cash), inline = true },
            { name = "Player", value = LocalPlayer.Name, inline = true },
            { name = "Server", value = "`" .. game.JobId .. "`" },
